# ─────────────────────────────────────────────────────────
# Lorelight — Environment Configuration
# Copy to .env and fill in all required values before running.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────

# ── Application ──────────────────────────────────────────
NODE_ENV=development
PORT=3001

# ── Security ─────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=CHANGE_ME_64_BYTE_HEX
JWT_REFRESH_SECRET=CHANGE_ME_64_BYTE_HEX_DIFFERENT

# Access token lifetime (e.g. 15m, 1h)
JWT_ACCESS_EXPIRES=15m
# Refresh token lifetime (e.g. 7d, 30d)
JWT_REFRESH_EXPIRES=7d

# Secret key used to encrypt stored provider API keys (AES-256-GCM)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SECRET_ENCRYPTION_KEY=CHANGE_ME_32_BYTE_HEX

# ── Bootstrap Admin ──────────────────────────────────────
# First admin user seeded on first `npm run db:seed`
ADMIN_EMAIL=admin@lorelight.local
ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD
ADMIN_NAME=Administrator

# ── Database ─────────────────────────────────────────────
POSTGRES_DB=lorelight
POSTGRES_USER=lorelight
POSTGRES_PASSWORD=lorelightdev
POSTGRES_PORT=5433
DATABASE_URL=postgresql://lorelight:lorelightdev@localhost:5433/lorelight?schema=public

# ── MinIO / Object Storage ────────────────────────────────
MINIO_ROOT_USER=lorelightminio
MINIO_ROOT_PASSWORD=lorelightminiodev
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ENDPOINT=localhost
MINIO_PORT_INTERNAL=9000
MINIO_USE_SSL=false
MINIO_BUCKET=lorelight-assets
# Public URL base used to construct presigned download URLs
MINIO_PUBLIC_URL=http://localhost:9000

# ── LLM Providers ────────────────────────────────────────
# Set at least one provider. All keys remain server-side only.

# OpenAI
OPENAI_API_KEY=
OPENAI_DEFAULT_MODEL=gpt-4o

# Ollama (local, accessible from Docker via host.docker.internal or custom IP)
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_DEFAULT_MODEL=llama3.2

# llama.cpp (OpenAI-compatible HTTP server)
LLAMACPP_BASE_URL=http://host.docker.internal:8080
LLAMACPP_DEFAULT_MODEL=default

# Default provider: openai | ollama | llamacpp
LLM_DEFAULT_PROVIDER=openai

# ── CORS ─────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# ── Rate Limiting ─────────────────────────────────────────
THROTTLE_TTL=60
THROTTLE_LIMIT=120
